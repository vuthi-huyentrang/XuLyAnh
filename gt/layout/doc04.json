    {
     "bbox": [
      148,
      260,
      1034,
      292
     ],
     "text": "vài điều chỉnh nhỏ mỗi ngày sẽ giúp bạn làm việc thoải mái và bền sức hơn.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "heading",
