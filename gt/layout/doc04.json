   ],
   "lines": [
    {
     "bbox": [
      177,
      460,
      748,
      493
     ],
     "text": "• Khuỷu tay tạo góc gần vuông khi đặt trên bàn.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "heading",
   "bbox": [
    148,
    522,
    362,
    554
   ],
   "lines": [
    {
     "bbox": [
      148,
      522,
      362,
      554
     ],
     "text": "2. Bảo vệ đôi mắt",
     "size": 14.0,
     "bold": true,
     "italic": false
    }
   ]
  },
  {
   "role": "paragraph",
   "bbox": [
