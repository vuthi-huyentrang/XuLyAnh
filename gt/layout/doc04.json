   ],
   "lines": [
    {
     "bbox": [
      177,
      369,
      816,
      401
     ],
     "text": "• Lưng thẳng, vai thả lỏng, hai chân đặt chắc trên sàn.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "list_item",
   "bbox": [
    177,
