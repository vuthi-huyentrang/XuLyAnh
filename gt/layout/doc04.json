    676
   ],
   "lines": [
    {
     "bbox": [
      148,
      569,
      1100,
      601
     ],
     "text": "Áp dụng quy tắc 20-20-20: cứ sau 20 phút làm việc, hãy nhìn một vật cách xa",
     "size": 14.0,
     "bold": false,
     "italic": false
    },
    {
     "bbox": [
      148,
      606,
      1100,
      639
     ],
     "text": "khoảng 6 mét trong 20 giây. Điều chỉnh độ sáng màn hình phù hợp với ánh sáng",
     "size": 14.0,
     "bold": false,
     "italic": false
    },
    {
     "bbox": [
      148,
      644,
      292,
      676
     ],
     "text": "xung quanh.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
