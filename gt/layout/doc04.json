    447
   ],
   "lines": [
    {
     "bbox": [
      177,
      414,
      877,
      447
     ],
     "text": "• Màn hình ngang tầm mắt, cách mắt khoảng một cánh tay.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "list_item",
   "bbox": [
    177,
