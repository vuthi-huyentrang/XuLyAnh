   ],
   "lines": [
    {
     "bbox": [
      148,
      223,
      1100,
      255
     ],
     "text": "Ngân sách giúp bạn biết tiền của mình đi đâu và chủ động hơn trong các mục tiêu",
     "size": 14.0,
     "bold": false,
     "italic": false
    },
    {
     "bbox": [
      148,
      260,
      1016,
      292
     ],
     "text": "tài chính. Chỉ cần theo dõi đều đặn, bạn sẽ thấy sự khác biệt sau vài tháng.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "heading",
   "bbox": [
    148,
    322,
    517,
    354
   ],
   "lines": [
    {
     "bbox": [
      148,
      322,
      517,
      354
     ],
     "text": "1. Ghi lại thu nhập và chi tiêu",
     "size": 14.0,
     "bold": true,
     "italic": false
    }
   ]
  },
  {
   "role": "paragraph",
   "bbox": [
    148,
    369,
    1100,
    438
   ],
   "lines": [
    {
     "bbox": [
      148,
      369,
      1100,
      401
     ],
     "text": "Trong một đến hai tháng đầu, hãy ghi lại mọi khoản thu và chi, dù nhỏ. Việc này",
     "size": 14.0,
     "bold": false,
     "italic": false
    },
    {
     "bbox": [
      148,
      406,
      987,
      438
     ],
     "text": "giúp bạn nhìn thấy những khoản chi phát sinh mà trước đây không để ý.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "heading",
   "bbox": [
    148,
    468,
    440,
    500
   ],
   "lines": [
    {
     "bbox": [
      148,
      468,
      440,
      500
     ],
     "text": "2. Phân chia theo nhóm",
     "size": 14.0,
     "bold": true,
     "italic": false
    }
   ]
  },
  {
   "role": "list_item",
   "bbox": [
    177,
    515,
    790,
    547
   ],
   "lines": [
    {
     "bbox": [
      177,
      515,
      790,
      547
     ],
     "text": "• Nhu cầu thiết yếu: nhà ở, ăn uống, đi lại, hóa đơn.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "list_item",
   "bbox": [
    177,
    560,
    760,
    593
   ],
   "lines": [
    {
     "bbox": [
      177,
      560,
      760,
      593
     ],
     "text": "• Mong muốn cá nhân: giải trí, mua sắm, du lịch.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "list_item",
   "bbox": [
    177,
    606,
    821,
    639
   ],
   "lines": [
    {
     "bbox": [
      177,
      606,
      821,
      639
     ],
     "text": "• Tiết kiệm và đầu tư: quỹ khẩn cấp, mục tiêu dài hạn.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "heading",
   "bbox": [
    148,
    668,
    394,
    700
   ],
   "lines": [
    {
     "bbox": [
      148,
      668,
      394,
      700
     ],
     "text": "3. Đặt tỷ lệ phù hợp",
     "size": 14.0,
     "bold": true,
     "italic": false
    }
   ]
  },
  {
   "role": "paragraph",
   "bbox": [
    148,
    715,
    1100,
    822
   ],
   "lines": [
    {
     "bbox": [
      148,
      715,
      1100,
      747
     ],
     "text": "Một cách phổ biến là chia theo tỷ lệ 50-30-20: khoảng một nửa thu nhập cho nhu",
     "size": 14.0,
     "bold": false,
     "italic": false
    },
    {
     "bbox": [
      148,
      752,
      1100,
      785
     ],
     "text": "cầu thiết yếu, ba phần mười cho mong muốn và hai phần mười cho tiết kiệm. Bạn",
     "size": 14.0,
     "bold": false,
     "italic": false
    },
    {
     "bbox": [
      148,
      790,
      713,
      822
     ],
     "text": "có thể điều chỉnh tỷ lệ này theo hoàn cảnh riêng.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "heading",
   "bbox": [
    148,
    852,
    475,
    884
   ],
   "lines": [
    {
     "bbox": [
      148,
      852,
      475,
      884
     ],
     "text": "4. Xây dựng quỹ khẩn cấp",
     "size": 14.0,
     "bold": true,
     "italic": false
    }
   ]
  },
  {
   "role": "list_item",
   "bbox": [
