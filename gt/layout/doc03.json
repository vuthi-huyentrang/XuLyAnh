   ],
   "lines": [
    {
     "bbox": [
      177,
      990,
      900,
      1022
     ],
     "text": "• Chỉ sử dụng quỹ này cho những tình huống thật sự bất ngờ.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
