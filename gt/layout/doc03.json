    843,
    931
   ],
   "lines": [
    {
     "bbox": [
      177,
      898,
      843,
      931
     ],
     "text": "• Đặt mục tiêu dự phòng bằng ba đến sáu tháng chi tiêu.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
