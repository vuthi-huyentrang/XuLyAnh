    971,
    668
   ],
   "lines": [
    {
     "bbox": [
      177,
      635,
      971,
      668
     ],
     "text": "• Ước lượng thời gian thực tế rồi cộng thêm một khoảng dự phòng.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
