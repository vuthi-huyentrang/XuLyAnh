  },
  {
   "role": "paragraph",
   "bbox": [
    148,
    406,
    1100,
    513
   ],
   "lines": [
    {
     "bbox": [
      148,
      406,
      1100,
      438
     ],
     "text": "Mỗi sáng, hãy chọn ra ba việc quan trọng nhất trong ngày và làm chúng trước.",
     "size": 14.0,
     "bold": false,
     "italic": false
    },
    {
     "bbox": [
      148,
      444,
      1100,
      476
     ],
     "text": "Những việc khẩn cấp nhưng ít giá trị nên được xử lý gọn hoặc nhờ người khác hỗ",
     "size": 14.0,
     "bold": false,
     "italic": false
    },
    {
     "bbox": [
      148,
      481,
      188,
      513
     ],
     "text": "trợ.",
     "size": 14.0,
     "bold": false,
