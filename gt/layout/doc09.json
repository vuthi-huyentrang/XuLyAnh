    622
   ],
   "lines": [
    {
     "bbox": [
      177,
      590,
      936,
      622
     ],
     "text": "• Chia việc lớn thành các bước nhỏ, mỗi bước có thời hạn riêng.",
     "size": 14.0,
     "bold": false,
     "italic": false
