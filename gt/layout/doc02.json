   ],
   "lines": [
    {
     "bbox": [
      177,
      369,
      972,
      401
     ],
     "text": "• Xác định rõ mục tiêu: cần thông báo, thảo luận hay ra quyết định.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "list_item",
   "bbox": [
    177,
