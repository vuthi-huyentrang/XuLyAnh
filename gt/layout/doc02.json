    667,
    447
   ],
   "lines": [
    {
     "bbox": [
      177,
      414,
      667,
      447
     ],
     "text": "• Chỉ mời những người thật sự liên quan.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "list_item",
   "bbox": [
    177,
