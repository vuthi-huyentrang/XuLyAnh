   ],
   "lines": [
    {
     "bbox": [
      148,
      322,
      403,
      354
     ],
     "text": "1. Lướt qua tổng thể",
     "size": 14.0,
     "bold": true,
     "italic": false
    }
   ]
  },
  {
   "role": "paragraph",
   "bbox": [
    148,
    369,
    1100,
    438
   ],
   "lines": [
    {
     "bbox": [
      148,
      369,
      1100,
      401
     ],
     "text": "Trước khi đọc kỹ, hãy xem nhan đề, mục lục, các tiêu đề nhỏ và đoạn kết. Bước",
     "size": 14.0,
     "bold": false,
     "italic": false
    },
    {
     "bbox": [
      148,
      406,
      1019,
      438
     ],
     "text": "này giúp bạn hình dung cấu trúc và biết nội dung nào cần chú ý nhiều hơn.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "heading",
   "bbox": [
    148,
    468,
    468,
    500
   ],
   "lines": [
    {
     "bbox": [
      148,
      468,
      468,
      500
     ],
     "text": "2. Đặt câu hỏi cho bài đọc",
     "size": 14.0,
     "bold": true,
     "italic": false
    }
   ]
  },
  {
   "role": "list_item",
   "bbox": [
    177,
    515,
    551,
    547
   ],
   "lines": [
    {
     "bbox": [
      177,
      515,
      551,
      547
     ],
     "text": "• Bài viết này trả lời vấn đề gì?",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "list_item",
   "bbox": [
    177,
    560,
    684,
    593
   ],
   "lines": [
    {
     "bbox": [
      177,
      560,
      684,
      593
     ],
     "text": "• Điều gì mình đã biết và điều gì còn mới?",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "list_item",
   "bbox": [
    177,
    606,
    699,
    639
   ],
   "lines": [
    {
     "bbox": [
      177,
      606,
      699,
      639
     ],
     "text": "• Mình cần tìm thông tin nào trong bài này?",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "heading",
   "bbox": [
    148,
    668,
    399,
    700
   ],
   "lines": [
    {
     "bbox": [
      148,
      668,
      399,
      700
     ],
     "text": "3. Đọc kỹ và ghi chú",
     "size": 14.0,
     "bold": true,
     "italic": false
    }
   ]
  },
  {
   "role": "list_item",
   "bbox": [
    177,
    715,
    1010,
    747
   ],
   "lines": [
    {
     "bbox": [
      177,
      715,
      1010,
      747
     ],
     "text": "• Gạch dưới hoặc đánh dấu những ý chính, không đánh dấu quá nhiều.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "list_item",
   "bbox": [
    177,
    761,
    675,
    793
   ],
   "lines": [
    {
     "bbox": [
      177,
      761,
      675,
      793
     ],
     "text": "• Ghi chú bên lề bằng lời của chính mình.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "list_item",
   "bbox": [
    177,
    806,
    815,
    839
   ],
   "lines": [
    {
     "bbox": [
      177,
      806,
      815,
      839
     ],
     "text": "• Dừng lại sau mỗi phần để tóm tắt trong một hai câu.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "heading",
   "bbox": [
    148,
