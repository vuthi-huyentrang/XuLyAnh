   ],
   "lines": [
    {
     "bbox": [
      148,
      915,
      1100,
      947
     ],
     "text": "Sau khi đọc xong, hãy gấp sách lại và nhắc lại những ý chính. Sau đó thử liên hệ",
     "size": 14.0,
     "bold": false,
     "italic": false
    },
    {
     "bbox": [
      148,
      952,
      1100,
      985
     ],
     "text": "với công việc hoặc kinh nghiệm của bạn, hoặc chia sẻ với người khác để kiến thức",
     "size": 14.0,
     "bold": false,
     "italic": false
    },
    {
     "bbox": [
      148,
      990,
      408,
      1022
     ],
     "text": "được ghi nhớ sâu hơn.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "paragraph",
   "bbox": [
