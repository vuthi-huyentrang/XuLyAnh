   ],
   "lines": [
    {
     "bbox": [
      148,
      223,
      1100,
      255
     ],
     "text": "Đọc nhiều chưa chắc đã hiểu sâu. Đọc có phương pháp giúp bạn nắm ý chính",
     "size": 14.0,
     "bold": false,
     "italic": false
    },
    {
     "bbox": [
      148,
      260,
      1004,
      292
     ],
     "text": "nhanh hơn và nhớ lâu hơn. Dưới đây là một quy trình đọc gồm bốn bước.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "heading",
   "bbox": [
    148,
