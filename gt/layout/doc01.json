    413,
    901
   ],
   "lines": [
    {
     "bbox": [
      148,
      868,
      413,
      901
     ],
     "text": "4. Ôn lại và vận dụng",
     "size": 14.0,
     "bold": true,
     "italic": false
    }
   ]
  },
  {
   "role": "paragraph",
   "bbox": [
