     "text": "PHƯƠNG PHÁP ĐỌC HIỂU HIỆU QUẢ",
     "size": 14.0,
     "bold": true,
     "italic": false
    }
   ]
  },
  {
   "role": "paragraph",
   "bbox": [
    148,
