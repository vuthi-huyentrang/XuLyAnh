     ],
     "text": "THÓI QUEN HỌC TẬP HIỆU QUẢ",
     "size": 14.0,
     "bold": true,
     "italic": false
    }
   ]
  },
  {
   "role": "paragraph",
   "bbox": [
    148,
    223,
    1100,
    292
   ],
   "lines": [
    {
     "bbox": [
      148,
      223,
      1100,
      255
     ],
     "text": "Học tốt không phụ thuộc vào việc học thật lâu, mà vào việc học đúng cách và đều",
     "size": 14.0,
     "bold": false,
     "italic": false
    },
    {
     "bbox": [
      148,
      260,
      1004,
      292
     ],
     "text": "đặn. Những thói quen dưới đây đã được nhiều người áp dụng thành công.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "heading",
   "bbox": [
    148,
    322,
    420,
    354
   ],
   "lines": [
    {
     "bbox": [
      148,
      322,
      420,
      354
     ],
     "text": "1. Đặt mục tiêu cụ thể",
     "size": 14.0,
     "bold": true,
     "italic": false
    }
   ]
  },
  {
   "role": "paragraph",
   "bbox": [
    148,
    369,
    1100,
    438
   ],
   "lines": [
    {
     "bbox": [
      148,
      369,
      1100,
      401
     ],
     "text": "Thay vì “học tiếng Anh”, hãy đặt mục tiêu như “học mười từ mới và ôn lại hai bài",
     "size": 14.0,
     "bold": false,
     "italic": false
    },
    {
     "bbox": [
      148,
      406,
      979,
      438
     ],
     "text": "cũ mỗi ngày”. Mục tiêu càng cụ thể thì càng dễ theo dõi và hoàn thành.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "heading",
   "bbox": [
    148,
    468,
    349,
    500
   ],
   "lines": [
    {
     "bbox": [
      148,
      468,
      349,
      500
     ],
     "text": "2. Học chủ động",
     "size": 14.0,
     "bold": true,
     "italic": false
    }
   ]
  },
  {
   "role": "list_item",
   "bbox": [
    177,
    515,
    764,
    547
   ],
   "lines": [
    {
     "bbox": [
      177,
      515,
      764,
      547
     ],
     "text": "• Tự đặt câu hỏi và trả lời mà không nhìn tài liệu.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "list_item",
   "bbox": [
    177,
    560,
    687,
    593
   ],
   "lines": [
    {
     "bbox": [
      177,
      560,
      687,
      593
     ],
     "text": "• Tóm tắt bài học bằng lời của chính mình.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "list_item",
   "bbox": [
    177,
    606,
    924,
    639
   ],
   "lines": [
    {
     "bbox": [
      177,
      606,
      924,
      639
     ],
     "text": "• Giải thích lại kiến thức cho người khác để kiểm tra mức hiểu.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "heading",
   "bbox": [
    148,
    668,
    411,
    700
   ],
   "lines": [
    {
     "bbox": [
      148,
      668,
      411,
      700
     ],
     "text": "3. Ôn tập ngắt quãng",
     "size": 14.0,
     "bold": true,
     "italic": false
    }
   ]
  },
  {
   "role": "list_item",
   "bbox": [
    177,
    715,
    726,
    747
   ],
   "lines": [
    {
     "bbox": [
      177,
      715,
      726,
      747
     ],
     "text": "• Ôn lại sau một ngày, một tuần và một tháng.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "list_item",
   "bbox": [
    177,
    761,
    917,
    793
   ],
   "lines": [
    {
     "bbox": [
      177,
      761,
      917,
      793
     ],
     "text": "• Ưu tiên ôn những phần còn yếu thay vì những phần đã vững.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "list_item",
   "bbox": [
    177,
    806,
    771,
    839
   ],
   "lines": [
    {
     "bbox": [
      177,
      806,
      771,
      839
     ],
     "text": "• Ghi chú ngắn gọn để việc ôn tập tốn ít thời gian.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "heading",
   "bbox": [
    148,
    868,
    415,
    901
   ],
   "lines": [
    {
     "bbox": [
      148,
      868,
      415,
      901
     ],
     "text": "4. Chăm sóc sức khỏe",
     "size": 14.0,
     "bold": true,
     "italic": false
    }
   ]
  },
  {
   "role": "paragraph",
   "bbox": [
    148,
    915,
    1100,
    985
   ],
   "lines": [
    {
     "bbox": [
      148,
      915,
      1100,
      947
     ],
     "text": "Ngủ đủ giấc, ăn uống điều độ và vận động nhẹ mỗi ngày giúp não bộ ghi nhớ tốt",
     "size": 14.0,
     "bold": false,
     "italic": false
    },
    {
     "bbox": [
      148,
      952,
      1023,
      985
     ],
     "text": "hơn. Một giấc ngủ đủ thường có ích hơn một đêm thức khuya để học thêm.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "paragraph",
   "bbox": [
    148,
    1021,
    1064,
    1054
   ],
   "lines": [
    {
     "bbox": [
      148,
      1021,
      1064,
      1054
     ],
     "text": "Kiên trì mỗi ngày một chút sẽ hiệu quả hơn việc học dồn trong thời gian ngắn.",
     "size": 14.0,
     "bold": false,
     "italic": true
    }
   ]
  }
