   ],
   "lines": [
    {
     "bbox": [
      148,
      868,
      304,
      901
     ],
     "text": "4. Luyện tập",
     "size": 14.0,
     "bold": true,
     "italic": false
    }
   ]
  },
  {
   "role": "paragraph",
   "bbox": [
    148,
    915,
    1100,
    985
   ],
   "lines": [
    {
     "bbox": [
      148,
      915,
      1100,
      947
     ],
     "text": "Hãy tập nói thành tiếng ít nhất hai đến ba lần và bấm giờ để kiểm soát thời lượng.",
     "size": 14.0,
     "bold": false,
     "italic": false
    },
    {
     "bbox": [
      148,
      952,
      785,
      985
     ],
     "text": "Nếu có thể, hãy nhờ một người bạn nghe thử và góp ý.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "paragraph",
   "bbox": [
    148,
    1021,
    1066,
    1054
   ],
   "lines": [
    {
     "bbox": [
      148,
      1021,
      1066,
      1054
     ],
     "text": "Sự tự tin đến từ sự chuẩn bị, và sự chuẩn bị tốt luôn được người nghe nhận ra.",
     "size": 14.0,
     "bold": false,
     "italic": true
