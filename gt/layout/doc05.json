    852,
    547
   ],
   "lines": [
    {
     "bbox": [
      177,
      515,
      852,
      547
     ],
     "text": "• Mở đầu: nêu vấn đề và lý do người nghe nên quan tâm.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "list_item",
   "bbox": [
    177,
    560,
    817,
    593
   ],
   "lines": [
    {
     "bbox": [
      177,
      560,
      817,
      593
     ],
     "text": "• Thân bài: chọn ba ý chính, mỗi ý có ví dụ minh họa.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "list_item",
   "bbox": [
    177,
    606,
    882,
    639
   ],
   "lines": [
    {
     "bbox": [
      177,
      606,
      882,
      639
     ],
     "text": "• Kết luận: nhắc lại thông điệp chính và đề nghị hành động.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "heading",
   "bbox": [
    148,
    668,
    365,
    700
   ],
   "lines": [
    {
     "bbox": [
      148,
      668,
      365,
      700
     ],
     "text": "3. Cách trình bày",
     "size": 14.0,
     "bold": true,
     "italic": false
    }
   ]
  },
  {
   "role": "list_item",
   "bbox": [
    177,
