    354
   ],
   "lines": [
    {
     "bbox": [
      148,
      322,
      384,
      354
     ],
     "text": "1. Hiểu người nghe",
     "size": 14.0,
     "bold": true,
     "italic": false
    }
   ]
  },
  {
   "role": "paragraph",
   "bbox": [
    148,
    369,
    1100,
    438
   ],
   "lines": [
    {
     "bbox": [
      148,
      369,
      1100,
      401
     ],
     "text": "Trước khi chuẩn bị, hãy tự hỏi người nghe là ai, họ đã biết gì và họ cần gì từ bài",
     "size": 14.0,
     "bold": false,
     "italic": false
    },
    {
     "bbox": [
      148,
      406,
      941,
      438
     ],
     "text": "nói. Nội dung phù hợp với người nghe luôn có sức thuyết phục hơn.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "heading",
   "bbox": [
    148,
    468,
    409,
    500
   ],
   "lines": [
    {
     "bbox": [
      148,
      468,
      409,
      500
     ],
     "text": "2. Xây dựng cấu trúc",
     "size": 14.0,
     "bold": true,
     "italic": false
    }
   ]
  },
  {
   "role": "list_item",
   "bbox": [
    177,
