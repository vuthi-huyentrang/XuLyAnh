   ],
   "lines": [
    {
     "bbox": [
      148,
      223,
      1100,
      255
     ],
     "text": "Thuyết trình tốt là biết truyền đạt thông điệp rõ ràng và tạo được sự quan tâm của",
     "size": 14.0,
     "bold": false,
     "italic": false
    },
    {
     "bbox": [
      148,
      260,
      785,
      292
     ],
     "text": "người nghe. Chuẩn bị kỹ là cách tốt nhất để tự tin hơn.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "heading",
   "bbox": [
    148,
    322,
