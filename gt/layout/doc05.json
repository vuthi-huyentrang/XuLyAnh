    790,
    747
   ],
   "lines": [
    {
     "bbox": [
      177,
      715,
      790,
      747
     ],
     "text": "• Nói chậm, rõ, nhấn mạnh những điểm quan trọng.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "list_item",
   "bbox": [
    177,
    761,
    843,
    793
   ],
   "lines": [
    {
     "bbox": [
      177,
      761,
      843,
      793
     ],
     "text": "• Giao tiếp bằng mắt với nhiều người trong khán phòng.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "list_item",
   "bbox": [
    177,
    806,
    910,
    839
   ],
   "lines": [
    {
     "bbox": [
      177,
      806,
      910,
      839
     ],
     "text": "• Dùng cử chỉ tự nhiên và tránh đọc lại nguyên văn từ tài liệu.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "heading",
   "bbox": [
