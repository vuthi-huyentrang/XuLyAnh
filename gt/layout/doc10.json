    743,
    830
   ],
   "lines": [
    {
     "bbox": [
      177,
      798,
      743,
      830
     ],
     "text": "• Góp ý vào công việc, không chỉ trích cá nhân.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "list_item",
   "bbox": [
    177,
    844,
    837,
    876
   ],
   "lines": [
    {
     "bbox": [
      177,
      844,
      837,
      876
     ],
     "text": "• Ghi nhận đóng góp của đồng đội một cách công bằng.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "heading",
   "bbox": [
    148,
    906,
    424,
    938
   ],
   "lines": [
    {
     "bbox": [
      148,
      906,
      424,
      938
     ],
     "text": "4. Giải quyết bất đồng",
     "size": 14.0,
     "bold": true,
     "italic": false
    }
   ]
  },
  {
   "role": "paragraph",
   "bbox": [
    148,
    952,
    1100,
    1060
   ],
   "lines": [
    {
     "bbox": [
      148,
      952,
      1100,
      985
     ],
     "text": "Bất đồng là điều bình thường. Hãy tập trung vào dữ kiện và mục tiêu chung, thảo",
     "size": 14.0,
     "bold": false,
     "italic": false
    },
    {
     "bbox": [
      148,
      990,
      1100,
      1022
     ],
     "text": "luận trực tiếp và bình tĩnh. Nếu chưa tìm được tiếng nói chung, nhóm có thể nhờ",
     "size": 14.0,
     "bold": false,
     "italic": false
    },
    {
     "bbox": [
      148,
      1027,
      840,
      1060
     ],
     "text": "người điều phối hoặc người có kinh nghiệm đứng ra hỗ trợ.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "paragraph",
   "bbox": [
    148,
    1096,
    1100,
    1166
   ],
   "lines": [
    {
     "bbox": [
      148,
      1096,
      1100,
      1129
     ],
     "text": "Một nhóm mạnh không phải là nhóm không có bất đồng, mà là nhóm biết biến bất",
     "size": 14.0,
     "bold": false,
     "italic": true
    },
    {
     "bbox": [
      148,
      1134,
      495,
      1166
     ],
     "text": "đồng thành giải pháp tốt hơn.",
     "size": 14.0,
     "bold": false,
     "italic": true
    }
   ]
  }
