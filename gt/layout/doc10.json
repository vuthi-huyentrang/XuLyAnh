   ],
   "lines": [
    {
     "bbox": [
      148,
      223,
      1100,
      255
     ],
     "text": "Làm việc nhóm tốt giúp công việc hoàn thành nhanh hơn, ít sai sót hơn và mang lại",
     "size": 14.0,
     "bold": false,
     "italic": false
    },
    {
     "bbox": [
      148,
      260,
      1100,
      292
     ],
     "text": "sự hài lòng cho mọi thành viên. Tài liệu này nêu ngắn gọn những quy tắc cơ bản",
     "size": 14.0,
     "bold": false,
     "italic": false
    },
    {
     "bbox": [
      148,
      298,
      542,
      330
     ],
     "text": "mà cả nhóm nên cùng thống nhất.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "heading",
   "bbox": [
    148,
    359,
    413,
    392
   ],
   "lines": [
    {
     "bbox": [
      148,
      359,
      413,
      392
     ],
     "text": "1. Mục tiêu và vai trò",
     "size": 14.0,
     "bold": true,
     "italic": false
    }
   ]
  },
  {
   "role": "paragraph",
   "bbox": [
    148,
    406,
    1100,
    476
   ],
   "lines": [
    {
     "bbox": [
      148,
      406,
      1100,
      438
     ],
     "text": "Mỗi người cần hiểu rõ mục tiêu chung của nhóm và phần việc của mình. Khi vai",
     "size": 14.0,
     "bold": false,
     "italic": false
    },
    {
     "bbox": [
      148,
      444,
      943,
      476
     ],
     "text": "trò rõ ràng, công việc không bị chồng chéo và cũng không bị bỏ sót.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "heading",
   "bbox": [
    148,
    505,
    470,
    538
   ],
   "lines": [
    {
     "bbox": [
      148,
      505,
      470,
      538
     ],
     "text": "2. Giao tiếp thường xuyên",
     "size": 14.0,
     "bold": true,
     "italic": false
    }
   ]
  },
  {
   "role": "list_item",
   "bbox": [
    177,
    552,
    965,
    584
   ],
   "lines": [
    {
     "bbox": [
      177,
      552,
      965,
      584
     ],
     "text": "• Cập nhật tiến độ đều đặn, ngay cả khi chưa có kết quả cuối cùng.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "list_item",
   "bbox": [
    177,
    598,
    790,
    630
   ],
   "lines": [
    {
     "bbox": [
      177,
      598,
      790,
      630
     ],
     "text": "• Báo sớm khi gặp khó khăn để cả nhóm kịp hỗ trợ.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "list_item",
   "bbox": [
    177,
    644,
    895,
    676
   ],
   "lines": [
    {
     "bbox": [
      177,
      644,
      895,
      676
     ],
     "text": "• Lắng nghe ý kiến khác trước khi đưa ra nhận xét của mình.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "heading",
   "bbox": [
    148,
    706,
    498,
    738
   ],
   "lines": [
    {
     "bbox": [
      148,
      706,
      498,
      738
     ],
     "text": "3. Tôn trọng và trách nhiệm",
     "size": 14.0,
     "bold": true,
     "italic": false
    }
   ]
  },
  {
   "role": "list_item",
   "bbox": [
    177,
    752,
    727,
    785
   ],
   "lines": [
    {
     "bbox": [
      177,
      752,
      727,
      785
     ],
     "text": "• Giữ đúng cam kết về thời hạn và chất lượng.",
     "size": 14.0,
     "bold": false,
     "italic": false
    }
   ]
  },
  {
   "role": "list_item",
   "bbox": [
    177,
